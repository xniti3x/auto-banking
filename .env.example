# Lokale Datenbankkonfiguration fuer Spring Boot.
# Die Werte vor dem Start als Umgebungsvariablen setzen.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bank
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
